# Google Gemini API key — get yours FREE at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# PostgreSQL database URL (async driver: asyncpg)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resum8

# Frontend URL — used for CORS configuration
FRONTEND_URL=http://localhost:5173

# Secret key — used for Fernet encryption of resume data
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_change_this_in_production

# Optional: Enable data persistence (save resumes to DB after processing)
# Set to true if you want to save candidate data; false for in-memory only
SAVE_RESUME_DATA=false

# Debug mode (set to false in production)
DEBUG=false
